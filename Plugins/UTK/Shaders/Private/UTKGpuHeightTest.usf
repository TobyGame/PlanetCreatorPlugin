#include "/Engine/Public/Platform.ush"

RWTexture2D<float4> OutputTexture;

int2 OutputSize;
float Frequency;
float Radius;
float Phase;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint X = DispatchThreadId.x;
	const uint Y = DispatchThreadId.y;

	if (X >= (uint)OutputSize.x || Y >= (uint)OutputSize.y)
		return;

	const float Width = max((float)OutputSize.x, 1.0);
	const float Height = max((float)OutputSize.y, 1.0);

	const float2 UV = (float2((float)X, (float)Y) + 0.5) / float2(Width, Height);
	const float2 P = UV * 2.0 - 1.0;

	const float Dist = length(P);
	const float SafeRadius = max(Radius, 0.0001);

	const float Falloff = saturate(1.0 - Dist / SafeRadius);
	const float Wave = 0.5 + 0.5 * sin((Dist * Frequency - Phase) * 6.28318530718);

	const float HeightValue = saturate(pow(Falloff, 1.5) * lerp(0.75, 1.0, Wave));

	OutputTexture[int2(X, Y)] = float4(HeightValue, HeightValue, HeightValue, 1.0);
}